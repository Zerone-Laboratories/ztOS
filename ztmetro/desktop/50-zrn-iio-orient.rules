// ztMETRO on a tablet: zrn-iio-orient reads the accelerometer through
// iio-sensor-proxy from the session greetd starts, which polkit does not
// always count as an active user session. Local users may claim the sensors.
polkit.addRule(function(action, subject) {
	if (action.id == "net.hadess.SensorProxy.claim-sensor" && subject.local) {
		return polkit.Result.YES;
	}
});
