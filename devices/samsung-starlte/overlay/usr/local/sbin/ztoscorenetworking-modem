#!/bin/sh
# ztoscorenetworking-modem: bring the modem up as stock Android's init did, around the
# vendor's own boot daemon (cbd), which loads the firmware from RADIO and
# starts the CP.
#
#   - load zrn-modem.ko (the mailbox, shared memory and modem interface);
#   - give the modem's device nodes their stock owners and modes (ueventd.rc:
#     /dev/umts* system:radio 0660), and radio read access to RADIO;
#   - mount the phone's EFS where stock does (/mnt/vendor/efs) inside the
#     Android root (zrn-android-root), as the stock fstab mounts it;
#   - run cbd with the stock service's command line, user and groups
#     (init.baseband.rc: user root, groups radio cache inet misc audio
#     sdcard_rw log sdcard_r shell system; cbd itself drops to radio).
#
# Like the other hardware here, a mark is left while the module loads; if the
# kernel stops, the next boot finds it and does not try again.
MARK=/var/lib/ztoscorenetworking/modem-loading
R=/run/android
mkdir -p /var/lib/ztoscorenetworking
if [ ! -e /dev/umts_boot0 ]; then
	if [ -e "$MARK" ]; then
		echo "ztoscorenetworking-modem: the last attempt did not finish; not loading. Remove $MARK to retry."
		exit 1
	fi
	touch "$MARK"; sync
	insmod /usr/local/lib/zrn-modem.ko || { echo "ztoscorenetworking-modem: the module did not load"; rm -f "$MARK"; exit 1; }
	sleep 2
	rm -f "$MARK"; sync
fi
chown 1000:1001 /dev/umts_* /dev/multipdp*
chown 1001:1001 /dev/umts_dm0 /dev/umts_router
chmod 0660 /dev/umts_* /dev/multipdp*
RADIO=$(readlink -f /dev/disk/by-partlabel/RADIO)
EFS=$(readlink -f /dev/disk/by-partlabel/EFS)
chgrp 1001 "$RADIO"; chmod 0640 "$RADIO"
/usr/local/sbin/zrn-android-root up || exit 1
mkdir -p $R/dev/block/platform/11120000.ufs/by-name $R/mnt/vendor/efs
ln -sf "$RADIO" $R/dev/block/platform/11120000.ufs/by-name/RADIO
ln -sf "$EFS" $R/dev/block/platform/11120000.ufs/by-name/EFS
mountpoint -q $R/mnt/vendor/efs || mount -t ext4 -o nosuid,nodev,noatime "$EFS" $R/mnt/vendor/efs
pgrep -x cbd >/dev/null && exit 0
exec chroot --groups=1001,2001,3003,9998,1005,1015,1007,1028,2000,1000 $R \
	/vendor/bin/cbd -d -tss310 -bm -mm -P platform/11120000.ufs/by-name/RADIO -n /mnt/vendor/efs
