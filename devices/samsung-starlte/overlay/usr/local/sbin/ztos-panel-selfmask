#!/usr/bin/env python3
# ztos-panel-selfmask: switch the Galaxy S9 panel's "self mask" off, once, at boot.
#
# The S6E3HA8 overlays an image from its own side memory on rows 0-149 and 2810-2959
# (the black rounded corners); the bootloader loads that image and enables it. The side
# memory is lost when the panel sleeps (DCS sleep in) while the mask stays enabled, so
# after the first sleep the panel shows dark patches along the top and the bottom.
# Samsung's kernel reloads the image on every resume; we do what its self_mask_dis
# sequence does instead: key, 7A 00, key. It stays off across sleeps, so with this done
# the panel can really sleep (panel_sleep=Y), which is about 157 mA of the idle draw.
#
# Only writes are sent: a DCS read disturbs this panel. Each is sent three times,
# because a long packet is now and then not taken.
import mmap
import os
import struct
import time

PKTHDR, PAYLOAD, INTSRC, FIFOSTAT = 0x58, 0x5C, 0x50, 0x68
m = mmap.mmap(os.open("/dev/mem", os.O_RDWR | os.O_SYNC), 0x1000, offset=0x16080000)   # DSIM0


def rd(o):
    return struct.unpack_from("<I", m, o)[0]


def wr(o, v):
    struct.pack_into("<I", m, o, v)


def idle():                                   # the header FIFO is empty
    for _ in range(5000):
        if rd(FIFOSTAT) & 0x400:
            return
        time.sleep(0.00002)


def cmd(*b):                                  # one DCS write
    idle()
    wr(INTSRC, 1 << 28)
    if len(b) <= 2:
        d = bytes(b) + b"\0"
        wr(PKTHDR, (0x05 if len(b) == 1 else 0x15) | d[0] << 8 | d[1] << 16)
    else:
        for i in range(0, len(b), 4):
            wr(PAYLOAD, int.from_bytes(bytes(b[i:i + 4]).ljust(4, b"\0"), "little"))
        wr(PKTHDR, 0x39 | len(b) << 8)
    idle()
    time.sleep(0.001)


for _ in range(3):
    cmd(0xF0, 0x5A, 0x5A)                     # level 2 key
    cmd(0x7A, 0x00)                           # self mask off
    cmd(0xF0, 0xA5, 0xA5)
    time.sleep(0.03)
