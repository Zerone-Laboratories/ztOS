#!/bin/sh
# Bring the sensor hub up: load its transport driver (zrn-bbd) and build the
# Android root that Broadcom's own daemon, lhd, runs in. lhd itself is started
# by ztoscsf-sensorhub.service after this.
#
# Like the sound driver, this one drives hardware the kernel knows nothing
# about (a SPI controller, a regulator, pins), so it is not in modules-load.d:
# a mark is left before loading and removed after. If loading ever stops the
# kernel, the phone restarts and finds the mark, and does not try again.
# Remove /var/lib/ztoscsf-sensorhub/loading to retry.
#
# SoC sleep is held off (zrn-sleepd's /run/zrn-sleepd/inhibit/timed-hub, its
# mtime the expiry) from the driver load through the patch download until
# the firmware is ready, or this attempt ends: a sleep must not land in the
# middle of a hub reset. ztoscsf's power retry takes it before its reset.
HOLD=/run/zrn-sleepd/inhibit/timed-hub
hold() {
	mkdir -p /run/zrn-sleepd/inhibit
	: > /run/zrn-sleepd/.hub.tmp &&
		touch -d "@$(( $(date +%s) + 45 ))" /run/zrn-sleepd/.hub.tmp &&
		mv -f /run/zrn-sleepd/.hub.tmp $HOLD
}
release() { rm -f $HOLD; }
if [ "${1:-}" = --run ]; then
	hold
	# ready is the driver's cached flag and may still say 1 from the last
	# lhd: let the hold go early only on a 0 -> 1 seen here, else it ends
	# by its own expiry
	stale=$(cat /sys/class/sec/sensorhub/ready 2>/dev/null)
	# lhd must run to download firmware, but gets only 30 seconds to do so.
	# Once ready, a lost hub ends this attempt instead of burning a core.
	/usr/bin/chroot /run/android /vendor/bin/hw/lhd /vendor/etc/sensor/lhd.conf &
	lhd_pid=$!
	# systemd also kills the entire control group, including unresponsive lhd.
	trap 'kill "$lhd_pid" 2>/dev/null; release' EXIT
	trap 'exit 0' TERM INT
	ready=0
	for attempt in $(seq 30); do
		kill -0 "$lhd_pid" 2>/dev/null || exit 1
		if [ "$(cat /sys/class/sec/sensorhub/ready 2>/dev/null)" = 1 ]; then
			ready=1
			break
		fi
		stale=0
		sleep 1
	done
	if [ "$ready" != 1 ]; then
		echo "ztoscsf-sensorhub: firmware not ready after 30 seconds; stopping lhd"
		exit 1
	fi
	if [ "$stale" = 1 ]; then
		echo "ztoscsf-sensorhub: hub ready (flag left from before; sleep held until the hold expires)"
	else
		echo "ztoscsf-sensorhub: hub ready"
		release
	fi
	while kill -0 "$lhd_pid" 2>/dev/null; do
		sleep 2
		if [ "$(cat /sys/class/sec/sensorhub/ready 2>/dev/null)" != 1 ]; then
			echo "ztoscsf-sensorhub: firmware lost readiness; stopping lhd"
			exit 1
		fi
	done
	exit 1
fi
MARK=/var/lib/ztoscsf-sensorhub/loading
mkdir -p /var/lib/ztoscsf-sensorhub
hold	# until --run has the firmware ready (or 45 s)
if [ ! -e /dev/zrn_ssp ]; then
	if [ -e "$MARK" ]; then
		echo "ztoscsf-sensorhub: the last attempt did not finish; not loading. Remove $MARK to retry."
		release; exit 1
	fi
	touch "$MARK"; sync
	modprobe zrn-bbd || { echo "ztoscsf-sensorhub: the driver did not load"; rm -f "$MARK"; release; exit 1; }
	sleep 2		# long enough for a fault to show
	rm -f "$MARK"; sync
fi
/usr/local/sbin/zrn-android-root up || { release; exit 1; }
