#!/bin/sh
# ztos-gnss: GPS on the Galaxy S9 (BCM4773), from the phone's own Broadcom
# daemons in /run/android:
#   lhd (ztoscsf-sensorhub.service, owns /dev/ttyBCM, boots the hub)
#   -> gpsd (vendor, /vendor/bin/hw/gpsd, Broadcom's GLL engine) over the
#      named pipe /data/vendor/gps/.pipe.gpsd_to_lhd
#   -> zrn-gnss-nmea (ours: loads /vendor/lib64/hw/gps.default.so)
#   -> NMEA on 127.0.0.1:10111 (inner)
#   -> ztos-gnss-gate: 127.0.0.1:10110 and /run/ztos-gnss/nmea.sock; it starts
#      this unit on the first reader and stops it when the last one leaves
# Needs the sensor hub up (lhd: ESW:READY). Evidence: sensors/GPS-REA.md.
R=/run/android
D=/var/lib/zrn-android/data/vendor/gps
L=/usr/local/lib/ztos-gnss
LAST=/var/lib/ztos-gnss/last
log() { echo "ztos-gnss: $*"; }

case "${1:-}" in
--pre)
	/usr/local/sbin/zrn-android-root up || exit 1
	mkdir -p $D/log /var/lib/zrn-android/data/local /dev/socket
	# stock init.gps.rc, post-fs-data: stale engine state files
	rm -f $D/gps_started $D/glonass_started $D/beidou_started $D/smd_started $D/sv_cno.info
	install -m 0644 $L/gps.xml $D/gps.xml
	install -m 0755 $L/zrn-gnss-nmea /var/lib/zrn-android/data/local/zrn-gnss-nmea
	# the last fix (ztos-gnss-gate keeps it on the host), for zrn-gnss-nmea -l
	rm -f $D/ztos-last
	[ -s $LAST ] && install -m 0600 $LAST $D/ztos-last
	# Broadcom's predicted orbits (LTO, lto2.dat in $D) come from
	# gllto.glpals.com, which gpsd fetches itself (HttpSyncLto). bionic
	# resolves names through netd's dnsproxyd, which this root lacks; its
	# only fallback is /system/etc/hosts. A hosts file of our own over it,
	# with that name looked up on the host each start. Only that one:
	# Broadcom's LBS servers (lbs.glpals.com, BCMLS2.glpals.com, LbsEnable)
	# trade the phone's data for aiding and stay unreachable, as before.
	hosts=/run/ztos-gnss/android-hosts
	mkdir -p /run/ztos-gnss
	{
		printf '127.0.0.1 localhost\n::1 ip6-localhost\n'
		for h in gllto.glpals.com; do
			a=$(timeout 5 getent ahostsv4 $h 2>/dev/null | awk 'NR == 1 { print $1 }')
			[ -n "$a" ] && printf '%s %s\n' "$a" "$h"
		done
	} > $hosts.new
	# rewritten in place: a bind mount follows the file, not its name
	cat $hosts.new > $hosts && rm -f $hosts.new
	findmnt -n $R/system/etc/hosts >/dev/null 2>&1 || mount --bind $hosts $R/system/etc/hosts
	# the hub must already be serving: lhd running and its firmware ready
	# (ready=1 is set once the patch is in). Wait up to 60 s, for a start
	# right after a hub restart. ready is cached: it cannot show a chip that
	# lost its firmware in a sleep, which is why the gate holds sleep off.
	i=0
	while ! pgrep -x lhd >/dev/null || [ "$(cat /sys/class/sec/sensorhub/ready 2>/dev/null)" != 1 ]; do
		i=$((i + 1)); [ $i -gt 60 ] && { log "sensor hub not ready (lhd or its firmware); not starting"; exit 1; }
		sleep 1
	done
	;;
--run)
	# no Android linker config in this root: libandroidicu.so is in the runtime APEX
	LD_LIBRARY_PATH=/apex/com.android.runtime/lib64 /usr/bin/chroot $R /vendor/bin/hw/gpsd -c /data/vendor/gps/gps.xml &
	gpsd_pid=$!
	nmea_pid=
	# Stopping (KillMode=mixed: only this script gets SIGTERM): the HAL
	# client first, which stops the engine and closes the HAL; gpsd then
	# exits by itself (status 0). Both killed at once, gpsd now and then
	# crashed (SIGSEGV) on its way out (2026-10-29). Its store, gldata.sto,
	# is written while it runs (NvmemWritePeriodMs in gps.xml), not here.
	stop() {
		trap - TERM INT
		if [ -n "$nmea_pid" ]; then
			kill -TERM $nmea_pid 2>/dev/null
			i=0; while kill -0 $nmea_pid 2>/dev/null && [ $i -lt 80 ]; do sleep 0.1; i=$((i + 1)); done
		fi
		kill -TERM $gpsd_pid 2>/dev/null
		i=0; while kill -0 $gpsd_pid 2>/dev/null && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
		kill -KILL $gpsd_pid $nmea_pid 2>/dev/null
		exit 0
	}
	trap stop TERM INT
	sleep 3
	kill -0 $gpsd_pid 2>/dev/null || { log "vendor gpsd exited"; exit 1; }
	# aiding: the clock when NTP has set it, and the last fix (--pre copies it)
	set --
	[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = yes ] && set -- -t
	[ -s $D/ztos-last ] && set -- "$@" -l /data/vendor/gps/ztos-last
	# bridge: if either dies, the unit restarts both
	/usr/bin/chroot $R /data/local/zrn-gnss-nmea -p 10111 -u /data/vendor/gps/.nmea-inner.sock "$@" ${ZTOS_GNSS_DEBUG:+-d} &
	nmea_pid=$!
	while kill -0 $gpsd_pid 2>/dev/null && kill -0 $nmea_pid 2>/dev/null; do sleep 1; done
	log "gpsd or bridge stopped"
	kill -TERM $gpsd_pid $nmea_pid 2>/dev/null
	exit 1
	;;
*)
	echo "usage: ztos-gnss --pre | --run" >&2; exit 2 ;;
esac
