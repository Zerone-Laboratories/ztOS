#!/usr/bin/env python3
"""ztos-iald: serves ztOSIAL on the system bus (see ial/ztos_ial/service.py)."""
import os
import sys

for candidate in ('/usr/lib/ztos-ial', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..')):
    if os.path.isdir(os.path.join(candidate, 'ztos_ial')):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from ztos_ial import service  # noqa: E402

if __name__ == '__main__':
    service.main()
