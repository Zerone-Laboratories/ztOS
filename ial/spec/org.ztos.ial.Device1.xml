<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- org.ztos.ial.Device1: What this phone is and which ztOSIAL interfaces it serves.
     Licence: LGPL-2.1-or-later. -->
<node>
  <interface name="org.ztos.ial.Device1">
    <property name="Version" type="u" access="read"/>
    <property name="Codename" type="s" access="read"/>
    <property name="Name" type="s" access="read"/>
    <property name="FormFactor" type="s" access="read"/>
    <property name="Scale" type="d" access="read"/>
    <property name="GsiVersion" type="s" access="read"/>
    <property name="Capabilities" type="as" access="read"/>
    <property name="Interfaces" type="a{su}" access="read"/>
    <property name="Backends" type="a{ss}" access="read"/>
    <property name="Missing" type="as" access="read"/>
    <property name="ManifestPath" type="s" access="read"/>
  </interface>
</node>
