<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- org.ztos.ial.Sensors1: Environmental and motion sensors. Read returns the current values of one sensor (light: lux; accelerometer: m/s^2 x,y,z; proximity: cm).
     Licence: LGPL-2.1-or-later. -->
<node>
  <interface name="org.ztos.ial.Sensors1">
    <property name="Version" type="u" access="read"/>
    <property name="Available" type="as" access="read"/>
    <method name="Read">
      <arg direction="in" name="sensor" type="s"/>
      <arg direction="out" name="values" type="ad"/>
    </method>
    <method name="SetAutoBrightness">
      <arg direction="in" name="enabled" type="b"/>
    </method>
  </interface>
</node>
