<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- org.ztos.ial.Haptics1: The vibration motor. Patterns are named (tap, click, notify, long).
     Licence: LGPL-2.1-or-later. -->
<node>
  <interface name="org.ztos.ial.Haptics1">
    <property name="Version" type="u" access="read"/>
    <property name="Patterns" type="as" access="read"/>
    <property name="Device" type="s" access="read"/>
    <method name="Play">
      <arg direction="in" name="pattern" type="s"/>
    </method>
    <method name="Vibrate">
      <arg direction="in" name="milliseconds" type="u"/>
      <arg direction="in" name="strength" type="d"/>
    </method>
  </interface>
</node>
