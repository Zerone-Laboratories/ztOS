<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- org.ztos.ial.CallAudio1: Where a voice call's sound goes: earpiece, speaker, headset or bluetooth.
     Licence: LGPL-2.1-or-later. -->
<node>
  <interface name="org.ztos.ial.CallAudio1">
    <property name="Version" type="u" access="read"/>
    <property name="Route" type="s" access="read"/>
    <property name="Routes" type="as" access="read"/>
    <property name="Muted" type="b" access="read"/>
    <method name="SetRoute">
      <arg direction="in" name="route" type="s"/>
    </method>
    <method name="SetMuted">
      <arg direction="in" name="muted" type="b"/>
    </method>
  </interface>
</node>
