<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- org.ztos.ial.Modem1: The cellular modem: radio, SIM, network, data, calls and SMS. Signal is 0..100.
     Licence: LGPL-2.1-or-later. -->
<node>
  <interface name="org.ztos.ial.Modem1">
    <property name="Version" type="u" access="read"/>
    <property name="Present" type="b" access="read"/>
    <property name="Powered" type="b" access="read"/>
    <property name="SimState" type="s" access="read"/>
    <property name="Operator" type="s" access="read"/>
    <property name="Signal" type="i" access="read"/>
    <property name="Technology" type="s" access="read"/>
    <property name="Registration" type="s" access="read"/>
    <property name="DataEnabled" type="b" access="read"/>
    <property name="DataConnected" type="b" access="read"/>
    <property name="CallState" type="s" access="read"/>
    <property name="CallNumber" type="s" access="read"/>
    <method name="SetPowered">
      <arg direction="in" name="powered" type="b"/>
    </method>
    <method name="SetDataEnabled">
      <arg direction="in" name="enabled" type="b"/>
    </method>
    <method name="Dial">
      <arg direction="in" name="number" type="s"/>
    </method>
    <method name="Answer"/>
    <method name="Hangup"/>
    <method name="SendSms">
      <arg direction="in" name="number" type="s"/>
      <arg direction="in" name="text" type="s"/>
    </method>
  </interface>
</node>
