+/*
+ * Exynos 9810 (Mali-G72, non-coherent): userspace fills write-combined BOs
+ * straight to DRAM, but the pages also sit in the kernel's cacheable linear
+ * map, and the CPU can speculatively pull those lines into its caches at any
+ * time. The GPU then meets stale CPU lines (DATA_INVALID, JOB_BUS, page
+ * faults at VA 0x0/0x10). Invalidating once is not enough, the lines come
+ * back; flushing before every job costs too much. So while panfrost holds
+ * the pages of a WC BO, make their linear-map entries invalid: nothing can
+ * cache them any more. Lines already cached are cleaned and invalidated
+ * once, through a temporary write-combined alias, after the TLB flush.
+ * Restored before the pages are dma-unmapped or given back (free, purge)
+ * and for good when the BO is exported (importers may sync through the
+ * linear map). Needs a page-granular linear map (rodata=full, the arm64
+ * default).
+ */
+static void panfrost_gem_lm_tlb_flush(struct page **pages, pgoff_t n)
+{
+	unsigned long lo = ULONG_MAX, hi = 0, a;
+	pgoff_t i;
+
+	for (i = 0; i < n; i++) {
+		if (!pages[i])
+			continue;
+		a = (unsigned long)page_address(pages[i]);
+		lo = min(lo, a);
+		hi = max(hi, a + PAGE_SIZE);
+	}
+	if (lo < hi)
+		flush_tlb_kernel_range(lo, hi);
+}
+
+void panfrost_gem_unmap_linear_alias(struct panfrost_gem_object *bo,
+				     struct page **pages, pgoff_t n)
+{
+	struct drm_gem_object *obj = &bo->base.base;
+	pgoff_t i;
+	void *va;
+
+	dma_resv_assert_held(obj->resv);
+
+	if (!bo->base.map_wc || drm_gem_is_imported(obj) || bo->lm_keep ||
+	    obj->dma_buf || !can_set_direct_map())
+		return;
+
+	for (i = 0; i < n; i++)
+		if (set_direct_map_invalid_noflush(pages[i]))
+			break;
+	if (i < n) {
+		while (i--)
+			set_direct_map_default_noflush(pages[i]);
+		panfrost_gem_lm_tlb_flush(pages, n);
+		return;
+	}
+	bo->lm_unmapped = true;
+	panfrost_gem_lm_tlb_flush(pages, n);
+
+	/* Cache maintenance by VA acts on the PA whatever the VA's type. */
+	va = vmap(pages, n, VM_MAP, pgprot_writecombine(PAGE_KERNEL));
+	if (va) {
+		dcache_clean_inval_poc((unsigned long)va,
+				       (unsigned long)va + n * PAGE_SIZE);
+		vunmap(va);
+	}
+}
+
+void panfrost_gem_restore_linear_alias(struct panfrost_gem_object *bo)
+{
+	struct drm_gem_shmem_object *shmem = &bo->base;
+	pgoff_t i, n = shmem->base.size >> PAGE_SHIFT;
+
+	if (!bo->lm_unmapped)
+		return;
+
+	if (shmem->pages) {
+		for (i = 0; i < n; i++)
+			if (shmem->pages[i])
+				set_direct_map_default_noflush(shmem->pages[i]);
+		panfrost_gem_lm_tlb_flush(shmem->pages, n);
+	}
+	bo->lm_unmapped = false;
+}
