+/*
+ * Fresh shmem pages are zeroed through the kernel cached linear map and
+ * dma_map_sgtable() only cleans those lines (arm64 sync_for_device is a
+ * clean, not a clean+invalidate). Userspace then fills the BO through a
+ * write-combined mapping, straight to DRAM. On Exynos 9810 the GPU still
+ * reads stale (zero) data for such pages, so the first job of a new
+ * process sees zeroed descriptors (DATA_INVALID / JOB_BUS / VA 0 faults).
+ * Drop the CPU-side lines once, when the pages are first handed to the
+ * GPU: they are already clean, so this only invalidates.
+ */
+static void panfrost_mmu_drop_cpu_lines(struct panfrost_device *pfdev,
+				       struct sg_table *sgt)
+{
+	if (!pfdev->coherent)
+		dma_sync_sgtable_for_cpu(pfdev->base.dev, sgt, DMA_FROM_DEVICE);
+}
