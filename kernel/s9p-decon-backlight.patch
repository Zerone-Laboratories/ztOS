+static void s9p_panel_brightness(struct s9p_decon *priv, unsigned int level)
+{
+	u8 aor[3] = { 0xB1 };
+	u16 v;
+
+	if (level >= S9P_BL_LEVELS)
+		level = S9P_BL_LEVELS - 1;
+	v = s9p_aor_table[level];
+	aor[1] = v >> 8;
+	aor[2] = v & 0xff;
+
+	s9p_hw_trigger_mask(priv);
+	s9p_wait_shadow_idle(priv);
+	s9p_dsim_write(priv, s9p_key2_on, sizeof(s9p_key2_on));
+	s9p_dsim_write(priv, aor, sizeof(aor));
+	s9p_dcs(priv, 0xF7, 0x03);
+	s9p_dsim_write(priv, s9p_key2_off, sizeof(s9p_key2_off));
+	s9p_hw_trigger_unmask(priv);
+}
+
+static int s9p_bl_update(struct backlight_device *bl)
+{
+	struct s9p_decon *priv = bl_get_data(bl);
+
+	/* blanked, or the panel asleep: nothing to send, and the level is
+	 * put back when the pipeline comes up again */
+	if (!priv->enabled || backlight_is_blank(bl))
+		return 0;
+	s9p_panel_brightness(priv, bl->props.brightness);
+	return 0;
+}
+
+static const struct backlight_ops s9p_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = s9p_bl_update,
+};
+
+static void s9p_backlight_init(struct s9p_decon *priv, struct device *dev)
+{
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = S9P_BL_LEVELS - 1,
+		/* the bootloader leaves the panel at its brightest */
+		.brightness = S9P_BL_LEVELS - 1,
+		.scale = BACKLIGHT_SCALE_NON_LINEAR,
+	};
+
+	priv->bl = devm_backlight_device_register(dev, "s9p-panel", dev, priv,
+						  &s9p_bl_ops, &props);
+	if (IS_ERR(priv->bl)) {
+		dev_warn(dev, "no backlight device: %pe\n", priv->bl);
+		priv->bl = NULL;
+	}
+}
