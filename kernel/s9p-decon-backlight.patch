+/*
+ * The panel's registers are behind access keys (the vendor calls them
+ * levels 1 to 3). Level 2 is the one the brightness and the self mask need.
+ */
+static const u8 s9p_key2_on[]  = { 0xF0, 0x5A, 0x5A };
+static const u8 s9p_key2_off[] = { 0xF0, 0xA5, 0xA5 };
+
+#define s9p_dcs(priv, ...) ({						\
+	static const u8 _b[] = { __VA_ARGS__ };				\
+	s9p_dsim_write((priv), _b, sizeof(_b));				\
+})
+
+/*
+ * The self mask: the panel overlays an image held in its own side memory on
+ * the first 150 and the last 150 rows (the rounded corners). The bootloader
+ * loads that image and switches the mask on; the side memory does not
+ * survive DCS sleep, so once the panel has slept the mask paints dark
+ * patches along the top and the bottom instead. The vendor reloads the image
+ * on every resume. We do what its self_mask_dis sequence does and switch the
+ * mask off for good, which is what makes panel_sleep usable at all.
+ */
+static void s9p_panel_selfmask_off(struct s9p_decon *priv)
+{
+	s9p_hw_trigger_mask(priv);
+	s9p_wait_shadow_idle(priv);
+	s9p_dsim_write(priv, s9p_key2_on, sizeof(s9p_key2_on));
+	s9p_dcs(priv, 0x7A, 0x00);
+	s9p_dsim_write(priv, s9p_key2_off, sizeof(s9p_key2_off));
+	s9p_hw_trigger_unmask(priv);
+}
