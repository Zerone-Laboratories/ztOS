+/*
+ * The other half: hold the trigger off. In command mode a frame transfer
+ * starts on every TE edge, and it shares DSIM's command FIFO, so a panel
+ * command sent in the middle of one is simply dropped (measured: from
+ * userspace, where this cannot be done, roughly one write in thirty lands).
+ * The vendor driver masks the trigger around its panel sequences too.
+ */
+static void s9p_hw_trigger_mask(struct s9p_decon *priv)
+{
+	u32 v;
+
+	if (!priv->command_mode || !priv->hw_trigger)
+		return;
+	v = readl_relaxed(priv->decon + DECON_HW_SW_TRIG_CONTROL);
+	v |= DECON_HW_TRIG_EN | DECON_HW_TRIG_MASK_DECON;
+	writel_relaxed(v, priv->decon + DECON_HW_SW_TRIG_CONTROL);
+}
