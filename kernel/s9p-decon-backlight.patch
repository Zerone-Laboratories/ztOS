 	s9p_decon_dcs(priv, MIPI_DCS_SET_DISPLAY_OFF);
 	if (!s9p_panel_sleep)
 		return;
 	msleep(PANEL_FRAME_DELAY_MS);
 	s9p_decon_dcs(priv, MIPI_DCS_ENTER_SLEEP_MODE);
 	msleep(PANEL_SLEEP_DELAY_MS);
+	s9p_hw_trigger_unmask(priv);
