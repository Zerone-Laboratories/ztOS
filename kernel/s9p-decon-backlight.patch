+/* ------------------------------------------------------- panel commands */
+
+/*
+ * One DCS write of any length. Short (one or two bytes) goes in the packet
+ * header alone; longer ones go through the payload FIFO first, little-endian
+ * four bytes at a time, and then a long-write header carrying the length --
+ * the order the vendor's dsim_write_data uses.
+ *
+ * The caller holds the hardware trigger off (s9p_hw_trigger_mask) so that no
+ * frame transfer is using the FIFO.
+ */
+static void s9p_dsim_write(struct s9p_decon *priv, const u8 *data, size_t len)
+{
+	u32 v, word = 0;
+	size_t i;
+
+	if (!priv->dsim || !s9p_panel_dcs || !len)
+		return;
+
+	writel_relaxed(DSIM_INTSRC_PH_FIFO_EMPTY, priv->dsim + DSIM_INTSRC);
+	if (len == 1) {
+		writel_relaxed(DSIM_PKTHDR_ID(MIPI_DCS_SHORT_WRITE) |
+			       DSIM_PKTHDR_DATA0(data[0]) |
+			       DSIM_PKTHDR_DATA1(0),
+			       priv->dsim + DSIM_PKTHDR);
+	} else {
+		for (i = 0; i < len; i++) {
+			word |= (u32)data[i] << (8 * (i % 4));
+			if (i % 4 == 3 || i == len - 1) {
+				writel_relaxed(word, priv->dsim + DSIM_PAYLOAD);
+				word = 0;
+			}
+		}
+		writel_relaxed(DSIM_PKTHDR_ID(MIPI_DCS_LONG_WRITE) |
+			       DSIM_PKTHDR_DATA0(len & 0xff) |
+			       DSIM_PKTHDR_DATA1(len >> 8),
+			       priv->dsim + DSIM_PKTHDR);
+	}
+	if (readl_poll_timeout_atomic(priv->dsim + DSIM_INTSRC, v,
+				      v & DSIM_INTSRC_PH_FIFO_EMPTY, 10, 20000))
+		dev_warn_once(priv->drm.dev,
+			      "panel did not take DCS %02x (INTSRC=%08x)\n",
+			      data[0], v);
+}
