[Unit]
Description=Start Waydroid in the background once the shell says, and report readiness

[Service]
Type=oneshot
Environment=XDG_RUNTIME_DIR=%t
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/local/libexec/ztos-waydroid-boot
# It waits for the shell's word (up to 180 s), then prepares and starts
# Android (up to 50 s more). The launcher and what it runs (the container's
# prepare) at a low priority; the session unit it starts is not affected.
TimeoutStartSec=240
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=default.target
