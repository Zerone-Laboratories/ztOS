+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+int ASharedMemory_create(const char *name, size_t size)
+{
+	int fd = memfd_create(name ? name : "ashmem", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+	if (fd < 0)
+		return -1;
+
+	if (size > 0 && ftruncate(fd, size) == -1) {
+		int saved = errno;
+		close(fd);
+		errno = saved;
+		return -1;
+	}
+
+	return fd;
+}
+
+size_t ASharedMemory_getSize(int fd)
+{
+	struct stat st;
+
+	if (fstat(fd, &st) == -1 || !S_ISREG(st.st_mode) || st.st_size < 0)
+		return 0;
+
+	return (size_t)st.st_size;
+}
+
+int ASharedMemory_setProt(int fd, int prot)
+{
+	const int valid = PROT_READ | PROT_WRITE | PROT_EXEC;
+	if (prot & ~valid) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	int current = fcntl(fd, F_GET_SEALS);
+	if (current < 0)
+		return -1;
+
+	/* memfd seals cannot revoke read or execute mapping access. */
+	if (!(prot & PROT_READ) || !(prot & PROT_EXEC)) {
+		errno = EOPNOTSUPP;
+		return -1;
+	}
+
+	if ((current & F_SEAL_FUTURE_WRITE) && (prot & PROT_WRITE)) {
+		errno = EACCES;
+		return -1;
+	}
+
+	int seals = 0;
+	if (!(prot & PROT_WRITE))
+		seals |= F_SEAL_FUTURE_WRITE;
+	if (!seals)
+		return 0;
+
+	return fcntl(fd, F_ADD_SEALS, seals);
+}
