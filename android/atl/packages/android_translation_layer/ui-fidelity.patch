+JNIEXPORT jint JNICALL Java_android_widget_TextView_native_1getBaseline(JNIEnv *env, jobject this, jint width, jint height)
+{
+	GtkWidget *widget = _PTR(_GET_LONG_FIELD(this, "widget"));
+	GtkLabel *label = box_get_label(env, widget);
+	if (!label) {
+		if (GTK_IS_TEXT(widget)) {
+			int baseline;
+			gtk_widget_measure(widget, GTK_ORIENTATION_VERTICAL, width, NULL, NULL, NULL, &baseline);
+			return baseline;
+		}
+		return -1;
+	}
+	if (width > 0 && gtk_widget_get_allocated_width(widget) == width &&
+	    gtk_widget_get_allocated_height(widget) == height) {
+		graphene_point_t origin = GRAPHENE_POINT_INIT(0, 0), offset;
+		if (gtk_widget_compute_point(GTK_WIDGET(label), widget, &origin, &offset)) {
+			int x, y;
+			gtk_label_get_layout_offsets(label, &x, &y);
+			return (jint)(offset.y + y + PANGO_PIXELS_CEIL(pango_layout_get_baseline(gtk_label_get_layout(label))));
+		}
+	}
+	int left = 0, right = 0, top = 0, bottom = 0;
+	for (GtkWidget *child = GTK_WIDGET(label); child; child = gtk_widget_get_parent(child)) {
+		GtkBorder padding, border;
+		GtkStyleContext *context = gtk_widget_get_style_context(child);
+		gtk_style_context_get_padding(context, &padding);
+		gtk_style_context_get_border(context, &border);
+		left += padding.left + border.left;
+		right += padding.right + border.right;
+		top += padding.top + border.top;
+		bottom += padding.bottom + border.bottom;
+		if (child == widget) break;
+	}
+	PangoLayout *layout = pango_layout_copy(gtk_label_get_layout(label));
+	pango_layout_set_width(layout, gtk_label_get_wrap(label) ? MAX(0, width - left - right) * PANGO_SCALE : -1);
+	int text_height;
+	pango_layout_get_pixel_size(layout, NULL, &text_height);
+	int baseline = top + (int)(MAX(0, height - top - bottom - text_height) * gtk_label_get_yalign(label))
+		+ PANGO_PIXELS_CEIL(pango_layout_get_baseline(layout));
+	g_object_unref(layout);
+	return baseline;
+}
