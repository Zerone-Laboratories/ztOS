+/* JNI modified UTF-8 encodes surrogate halves separately; Pango needs Unicode UTF-8. */
+char *atl_jstring_to_utf8(JNIEnv *env, jstring text)
+{
+	if (!text) return g_strdup("");
+	const jchar *chars = (*env)->GetStringChars(env, text, NULL);
+	if (!chars) return NULL;
+	jsize length = (*env)->GetStringLength(env, text);
+	GString *utf8 = g_string_sized_new(length);
+	for (jsize i = 0; i < length; i++) {
+		gunichar codepoint = chars[i];
+		if (codepoint >= 0xd800 && codepoint <= 0xdbff && i + 1 < length &&
+		    chars[i + 1] >= 0xdc00 && chars[i + 1] <= 0xdfff) {
+			codepoint = 0x10000 + ((codepoint - 0xd800) << 10) + (chars[++i] - 0xdc00);
+		} else if (codepoint >= 0xd800 && codepoint <= 0xdfff) {
+			codepoint = 0xfffd;
+		}
+		char encoded[6];
+		int bytes = g_unichar_to_utf8(codepoint, encoded);
+		g_string_append_len(utf8, encoded, bytes);
+	}
+	(*env)->ReleaseStringChars(env, text, chars);
+	return g_string_free(utf8, FALSE);
+}
+
+jstring atl_utf8_to_jstring(JNIEnv *env, const char *text)
+{
+	if (!text) return NULL;
+	glong length;
+	gunichar2 *chars = g_utf8_to_utf16(text, -1, NULL, &length, NULL);
+	if (!chars) return NULL;
+	jstring result = (*env)->NewString(env, (const jchar *)chars, (jsize)length);
+	g_free(chars);
+	return result;
+}
