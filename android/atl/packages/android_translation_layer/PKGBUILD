prepare() {
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/keystore-aes.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/sizef.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/display-touch.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/text-sizing.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/rendering.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/input-actions.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/compatibility.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/graphics-quality.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/audio-safety.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/sdk-consistency.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/widget-alignment.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/sharedmem.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/hardware-buffer-compat.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/resources-constructor-dispatch.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/resources-classloader-compat.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/context-telecom-service.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/keygen-randomization-compat.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/context-main-executor.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/textview-soft-input-focus.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/touch-longpress-cancel.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/textview-line-limits.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/runtime-ui-timers.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/touch-sequence-lifecycle.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/audio-playback-callback.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/inflater-image-state.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/textview-autosize.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/textview-typography.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/subscription-defaults.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/longpress-allocation.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/bitmap-rendering.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/apk-signing-v2-v3.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/location-enabled.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/view-get-focusable.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/typeface-style-italic.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/view-focusable-mode.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/font-rendering.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/static-layout-builder.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/textpaint-copy.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/apk-signing-platform-level.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/view-outline-shadow-color.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/aosp-api-batch1.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/ui-fidelity.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/ui-fidelity-2.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/ui-fidelity-3.patch"
  patch -d "${_upstream_pkgname}-${_commit}" -Np1 -i "$srcdir/ui-fidelity-4.patch"
  cp "$srcdir/CryptoProvider.java" "${_upstream_pkgname}-${_commit}/src/api-impl/android/security/CryptoProvider.java"
  # ztMETRO supplies its own OSK through text-input-v3, not layer-shell.
  sed -i "s/layer_shell_dep = dependency('gtk4-layer-shell-0', required : false)/layer_shell_dep = disabler()/" "${_upstream_pkgname}-${_commit}/meson.build"
  meson subprojects download --sourcedir="${_upstream_pkgname}-${_commit}"
}

build() {
  arch-meson "${_upstream_pkgname}-${_commit}" build
  meson compile -C build
}

check() {
  meson test --no-rebuild --print-errorlogs -C build
}

package() {
  meson install --no-rebuild -C build --destdir "${pkgdir}"
  install -Dm644 "$srcdir/apksig-8.9.1-d8.jar" "${pkgdir}/usr/lib/java/dex/android_translation_layer/apksig.jar"
  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  bsdtar -xOf "$srcdir/apksig-8.9.1.jar" LICENSE > "${pkgdir}/usr/share/licenses/${pkgname}/apksig-LICENSE"
  chown -R root:root "${pkgdir}"
}
