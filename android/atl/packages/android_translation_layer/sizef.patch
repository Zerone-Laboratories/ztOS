+		SizeF other = (SizeF) obj;
+		return width == other.width && height == other.height;
+	}
+
+	@Override
+	public int hashCode() {
+		return Float.floatToIntBits(width) ^ Float.floatToIntBits(height);
+	}
+
+	@Override
+	public String toString() {
+		return width + "x" + height;
+	}
 }
