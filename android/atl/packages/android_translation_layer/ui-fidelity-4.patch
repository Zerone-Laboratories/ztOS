+/* Pango trims edge tracking after breaking/ellipsizing. Android advances must
+ * retain it, or a layout sized to ceil(measureText()) can already ellipsize. */
+static int edge_tracking(PangoLayoutRun *run, const char *text, gboolean left)
+{
+	if (!run->glyphs->num_glyphs || text[run->item->offset] == '\t') return 0;
+	int spacing = 0;
+	for (GSList *node = run->item->analysis.extra_attrs; node; node = node->next) {
+		PangoAttribute *attr = node->data;
+		if (attr->klass->type == PANGO_ATTR_SHAPE) return 0;
+		if (attr->klass->type == PANGO_ATTR_LETTER_SPACING)
+			spacing = ((PangoAttrInt *)attr)->value;
+	}
+	int half = spacing / 2;
+	if ((spacing & (PANGO_SCALE - 1)) == 0) half = PANGO_UNITS_ROUND(half);
+	return left ? half : spacing - half;
+}
+
+float android_paint_get_line_advance(PangoLayoutLine *line)
+{
+	PangoRectangle logical;
+	pango_layout_line_get_extents(line, NULL, &logical);
+	int tracking = 0;
+	if (line->runs) {
+		const char *text = pango_layout_get_text(line->layout);
+		tracking += edge_tracking(line->runs->data, text, TRUE);
+		tracking += edge_tracking(g_slist_last(line->runs)->data, text, FALSE);
+	}
+	return (float)(logical.width + tracking) / PANGO_SCALE;
+}
