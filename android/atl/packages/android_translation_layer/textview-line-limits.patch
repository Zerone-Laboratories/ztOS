+/* Apply Android line limits to text labels, including Button subclasses.
+ * EditText uses GtkText and handles its own input layout. */
+static GtkLabel *text_limits_find_label(GtkWidget *widget)
+{
+	if (GTK_IS_LABEL(widget)) return GTK_LABEL(widget);
+	for (GtkWidget *child = gtk_widget_get_first_child(widget); child;
+	     child = gtk_widget_get_next_sibling(child)) {
+		GtkLabel *label = text_limits_find_label(child);
+		if (label) return label;
+	}
+	return NULL;
+}
+
+JNIEXPORT void JNICALL Java_android_widget_TextView_native_1setTextLimits(JNIEnv *env, jobject this,
+        jint max_lines, jboolean single_line, jint ellipsize)
+{
+	GtkWidget *widget = _PTR(_GET_LONG_FIELD(this, "widget"));
+	GtkLabel *label = text_limits_find_label(widget);
+	if (!label) return;
+	gtk_label_set_single_line_mode(label, single_line);
+	gtk_label_set_wrap(label, !single_line);
+	gtk_label_set_lines(label, max_lines > 0 ? max_lines : -1);
+	PangoEllipsizeMode mode = ellipsize == 1 ? PANGO_ELLIPSIZE_START
+	        : ellipsize == 2 ? PANGO_ELLIPSIZE_MIDDLE
+	        : ellipsize == 3 || max_lines > 0 ? PANGO_ELLIPSIZE_END : PANGO_ELLIPSIZE_NONE;
+	/* Pango's line cap needs ellipsization to constrain natural measurement.
+	 * MARQUEE keeps an end ellipsis until scrolling text is implemented. */
+	gtk_label_set_ellipsize(label, mode);
+}
