+/* Binary-search actual shaped text metrics instead of guessing from character count. */
+JNIEXPORT jint JNICALL Java_android_widget_TextView_native_1findAutoSize(JNIEnv *env, jobject this,
+        jintArray sizes_array, jint width, jint height, jint max_lines, jboolean single_line)
+{
+    GtkWidget *widget = _PTR(_GET_LONG_FIELD(this, "widget"));
+    GtkLabel *label = text_limits_find_label(widget);
+    if (!label || width <= 0 || height <= 0) return -1;
+    int count = (*env)->GetArrayLength(env, sizes_array);
+    if (!count) return -1;
+    jint *sizes = (*env)->GetIntArrayElements(env, sizes_array, NULL);
+    PangoLayout *layout = pango_layout_copy(gtk_label_get_layout(label));
+    const PangoFontDescription *current = pango_layout_get_font_description(layout);
+    if (!current) current = pango_context_get_font_description(gtk_widget_get_pango_context(GTK_WIDGET(label)));
+    PangoFontDescription *font = pango_font_description_copy(current);
+    pango_layout_set_ellipsize(layout, PANGO_ELLIPSIZE_NONE);
+    pango_layout_set_single_paragraph_mode(layout, single_line);
+    pango_layout_set_wrap(layout, PANGO_WRAP_WORD_CHAR);
+    pango_layout_set_width(layout, single_line ? -1 : MIN(width, G_MAXINT / PANGO_SCALE) * PANGO_SCALE);
+    int low = 0, high = count - 1, best = 0;
+    while (low <= high) {
+        int middle = low + (high - low) / 2;
+        pango_font_description_set_absolute_size(font, (double)sizes[middle] * PANGO_SCALE);
+        pango_layout_set_font_description(layout, font);
+        int text_width, text_height;
+        pango_layout_get_pixel_size(layout, &text_width, &text_height);
+        if (text_width <= width && text_height <= height && pango_layout_get_line_count(layout) <= max_lines) {
+            best = middle; low = middle + 1;
+        } else {
+            high = middle - 1;
+        }
+    }
+    int result = sizes[best];
+    pango_font_description_free(font);
+    g_object_unref(layout);
+    (*env)->ReleaseIntArrayElements(env, sizes_array, sizes, JNI_ABORT);
+    return result;
+}
