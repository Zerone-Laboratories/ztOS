diff -Naur base/src/libandroid/hardware_buffer.c source/src/libandroid/hardware_buffer.c
--- base/src/libandroid/hardware_buffer.c	1970-01-01 05:30:00.000000000 +0530
+++ source/src/libandroid/hardware_buffer.c	2026-10-23 09:38:40.641905899 +0530
@@ -0,0 +1,597 @@
