+    private void schedule(int type, long triggerTime, final long interval, final PendingIntent operation) {
+        if (operation == null) throw new NullPointerException("operation");
+        long now = type == ELAPSED_REALTIME || type == ELAPSED_REALTIME_WAKEUP
+                ? SystemClock.elapsedRealtime() : System.currentTimeMillis();
