+            cancel(operation);
+            Runnable task = new Runnable() {
+                public void run() {
+                    synchronized (scheduled) {
+                        if (scheduled.get(operation) != this) return;
+                        if (interval == 0) scheduled.remove(operation);
+                    }
+                    operation.send();
+                    synchronized (scheduled) {
+                        if (interval > 0 && scheduled.get(operation) == this)
+                            scheduler().postDelayed(this, interval);
+                    }
+                }
+            };
+            scheduled.put(operation, task);
+            scheduler().postDelayed(task, Math.max(0, triggerTime - now));
+        }
+    }
 
