+package android.text.method;
+
+import android.graphics.Rect;
+import android.text.Spanned;
+import android.view.View;
+
+/** A live character substitution view that preserves source spans and indices. */
+public abstract class ReplacementTransformationMethod implements TransformationMethod {
+    protected abstract char[] getOriginal();
+    protected abstract char[] getReplacement();
+
+    public CharSequence getTransformation(CharSequence source, View view) {
+        if (source == null) return null;
+        char[] original = getOriginal(), replacement = getReplacement();
+        return source instanceof Spanned
+                ? new SpannedReplacement((Spanned) source, original, replacement)
+                : new Replacement(source, original, replacement);
+    }
+
+    public void onFocusChanged(View view, CharSequence source, boolean focused,
+                               int direction, Rect previouslyFocusedRect) {}
+
+    private static class Replacement implements CharSequence {
+        final CharSequence source;
+        final char[] original, replacement;
+        Replacement(CharSequence source, char[] original, char[] replacement) {
+            this.source = source; this.original = original; this.replacement = replacement;
+        }
+        public int length() { return source.length(); }
+        public char charAt(int index) {
+            char c = source.charAt(index);
+            for (int i = 0; i < original.length; i++)
+                if (c == original[i]) return replacement[i];
+            return c;
+        }
+        public CharSequence subSequence(int start, int end) {
+            CharSequence sub = source.subSequence(start, end);
+            return sub instanceof Spanned
+                    ? new SpannedReplacement((Spanned) sub, original, replacement)
+                    : new Replacement(sub, original, replacement);
+        }
+        public String toString() {
+            StringBuilder out = new StringBuilder(length());
+            for (int i = 0; i < length(); i++) out.append(charAt(i));
+            return out.toString();
+        }
+    }
+    private static final class SpannedReplacement extends Replacement implements Spanned {
+        final Spanned spanned;
+        SpannedReplacement(Spanned source, char[] original, char[] replacement) {
+            super(source, original, replacement); spanned = source;
+        }
+        public <T> T[] getSpans(int start, int end, Class<T> type) { return spanned.getSpans(start, end, type); }
+        public int getSpanStart(Object tag) { return spanned.getSpanStart(tag); }
+        public int getSpanEnd(Object tag) { return spanned.getSpanEnd(tag); }
+        public int getSpanFlags(Object tag) { return spanned.getSpanFlags(tag); }
+        public int nextSpanTransition(int start, int limit, Class type) { return spanned.nextSpanTransition(start, limit, type); }
+    }
+}
