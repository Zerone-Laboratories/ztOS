+package android.text.method;
+
+/** Keep single-line display text the same length as its editable source. */
+public class SingleLineTransformationMethod extends ReplacementTransformationMethod {
+    private static final SingleLineTransformationMethod INSTANCE = new SingleLineTransformationMethod();
+    private static final char[] ORIGINAL = {'\n', '\r'};
+    private static final char[] REPLACEMENT = {' ', '\uFEFF'};
+    protected char[] getOriginal() { return ORIGINAL; }
+    protected char[] getReplacement() { return REPLACEMENT; }
+    public static SingleLineTransformationMethod getInstance() { return INSTANCE; }
+}
