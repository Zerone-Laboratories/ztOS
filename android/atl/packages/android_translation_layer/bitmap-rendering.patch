+/* Same as native_constructor(), but always creates a JavaPaintable, for
+ * classes that override draw() and need snapshot callbacks (e.g. tinted
+ * BitmapDrawable). The returned paintable holds a weak ref to `this'. */
+JNIEXPORT jlong JNICALL Java_android_graphics_drawable_Drawable_native_1new_1java_1paintable(JNIEnv *env, jobject this)
+{
+	JavaPaintable *paintable = g_object_new(java_paintable_get_type(), NULL);
+	paintable->drawable = _WEAK_REF(this);
+	return _INTPTR(paintable);
+}
