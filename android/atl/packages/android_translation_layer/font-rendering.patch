+/* Apply Typeface family/weight/style to the paint's existing Pango font
+ * description. Size and other fields are untouched, so text measurement
+ * (layouts, font metrics) picks the change up through paint->font. */
+JNIEXPORT void JNICALL Java_android_graphics_Paint_native_1set_1typeface(JNIEnv *env, jclass clazz, jlong paint_ptr, jstring family_ptr, jint weight, jboolean italic)
+{
+	struct AndroidPaint *paint = _PTR(paint_ptr);
+	const char *family = family_ptr ? (*env)->GetStringUTFChars(env, family_ptr, NULL) : NULL;
+	if (family)
+		pango_font_description_set_family(paint->font, family);
+	else
+		pango_font_description_unset_fields(paint->font, PANGO_FONT_MASK_FAMILY);
+	pango_font_description_set_weight(paint->font, (PangoWeight)CLAMP(weight, 100, 1000));
+	pango_font_description_set_style(paint->font, italic ? PANGO_STYLE_ITALIC : PANGO_STYLE_NORMAL);
+	if (family)
+		(*env)->ReleaseStringUTFChars(env, family_ptr, family);
 }
 
