+
+/* Apply Typeface family/weight/style through the existing Pango attr list,
+ * same update pattern as native_applyTypography: copy the current list and
+ * change only a font-desc attribute without a size, so the CSS font-size,
+ * the tnum font features and line-height attributes are preserved. */
+JNIEXPORT void JNICALL Java_android_widget_TextView_native_1setTypeface(JNIEnv *env, jobject this,
+        jstring family_ptr, jint weight, jboolean italic, jstring variations_ptr)
+{
+    GtkWidget *widget = _PTR(_GET_LONG_FIELD(this, "widget"));
+    GtkLabel *label = GTK_IS_TEXT(widget) ? NULL : text_limits_find_label(widget);
+    if (!label && !GTK_IS_TEXT(widget)) return;
+    PangoAttrList *current = label ? gtk_label_get_attributes(label) : gtk_text_get_attributes(GTK_TEXT(widget));
+    PangoAttrList *attributes = current ? pango_attr_list_copy(current) : pango_attr_list_new();
+
+    PangoFontDescription *font = pango_font_description_new();
+    const char *family = family_ptr ? (*env)->GetStringUTFChars(env, family_ptr, NULL) : NULL;
+    const char *variations = variations_ptr ? (*env)->GetStringUTFChars(env, variations_ptr, NULL) : NULL;
+    if (family)
+        pango_font_description_set_family(font, family);
+    pango_font_description_set_weight(font, (PangoWeight)CLAMP(weight, 100, 1000));
+    pango_font_description_set_style(font, italic ? PANGO_STYLE_ITALIC : PANGO_STYLE_NORMAL);
+    if (variations && *variations)
+        pango_font_description_set_variations(font, variations);
+    pango_attr_list_change(attributes, pango_attr_font_desc_new(font));
+    pango_font_description_free(font);
+
+    if (label) gtk_label_set_attributes(label, attributes);
+    else gtk_text_set_attributes(GTK_TEXT(widget), attributes);
+    pango_attr_list_unref(attributes);
+    if (family)
+        (*env)->ReleaseStringUTFChars(env, family_ptr, family);
+    if (variations)
+        (*env)->ReleaseStringUTFChars(env, variations_ptr, variations);
+}
