+#include <jni.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+JNIEXPORT void JNICALL Java_android_os_Build_00024VERSION_nativePublishSdkInt(JNIEnv *env, jclass clazz, jint sdkInt)
+{
+	(void)env;
+	(void)clazz;
+	if (sdkInt >= 1 && sdkInt <= 1000) {
+		char buf[16];
+		snprintf(buf, sizeof(buf), "%d", (int)sdkInt);
+		if (setenv("ATL_SDK_INT", buf, 1) != 0) {
+			jclass error = (*env)->FindClass(env, "java/lang/IllegalStateException");
+			if (error) (*env)->ThrowNew(env, error, "Cannot publish Android SDK property");
+		}
+	}
+}
