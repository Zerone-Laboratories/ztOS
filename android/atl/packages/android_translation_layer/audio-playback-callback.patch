+package android.media;
+
+import android.os.Parcelable;
+
+/** Immutable metadata for an Android-managed audio player. */
+public final class AudioPlaybackConfiguration implements Parcelable {
+    private final AudioAttributes attributes;
+    private final int sessionId, playerState, clientUid, clientPid, playerType;
+
+    AudioPlaybackConfiguration(AudioAttributes attributes, int sessionId, int playerState,
+                               int clientUid, int clientPid, int playerType) {
+        this.attributes = attributes; this.sessionId = sessionId; this.playerState = playerState;
+        this.clientUid = clientUid; this.clientPid = clientPid; this.playerType = playerType;
+    }
+    public AudioAttributes getAudioAttributes() { return attributes; }
+    public int getAudioSessionId() { return sessionId; }
+    public int getPlayerState() { return playerState; }
+    public int getClientUid() { return clientUid; }
+    public int getClientPid() { return clientPid; }
+    public int getPlayerType() { return playerType; }
+    public boolean isActive() { return playerState == 2; }
+}
