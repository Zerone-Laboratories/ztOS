+    public String getFontFeatureSettings() { return fontFeatureSettings; }
+    public void setFontFeatureSettings(String settings) {
+        String parsed = parseFontSettings(settings, false);
+        fontFeatureSettings = settings; pangoFontFeatures = parsed;
+        applyTypography(); requestLayout();
+    }
+    public String getFontVariationSettings() { return fontVariationSettings; }
+    public boolean setFontVariationSettings(String settings) {
+        try {
+            String parsed = parseFontSettings(settings, true);
+            fontVariationSettings = settings; pangoFontVariations = parsed;
+            applyTypography(); requestLayout(); return true;
+        } catch (IllegalArgumentException error) { return false; }
+    }
+    private static String parseFontSettings(String settings, boolean variation) {
+        if (settings == null || settings.trim().isEmpty()) return "";
+        StringBuilder result = new StringBuilder();
+        for (String setting : settings.split(",")) {
+            String normalized = setting.trim().replace("'", "").replace("\"", "");
+            String[] parts = normalized.split("[=\\s]+", 2);
+            if (parts.length == 0 || parts[0].length() != 4 || variation && parts.length != 2)
+                throw new IllegalArgumentException("Invalid font setting " + setting);
+            for (int i = 0; i < 4; i++)
+                if (parts[0].charAt(i) < 32 || parts[0].charAt(i) > 126)
+                    throw new IllegalArgumentException("Invalid font tag");
+            String value = parts.length == 1 ? "1" : parts[1].trim();
+            if (!variation) {
+                if (value.equals("on")) value = "1";
+                if (value.equals("off")) value = "0";
+                value = Integer.toString(Integer.parseInt(value));
+            } else {
+                float number = Float.parseFloat(value);
+                if (Float.isNaN(number) || Float.isInfinite(number)) throw new IllegalArgumentException("Invalid font axis");
+                value = Float.toString(number);
+            }
+            if (result.length() > 0) result.append(',');
+            result.append(parts[0]).append('=').append(value);
+        }
+        return result.toString();
+    }
