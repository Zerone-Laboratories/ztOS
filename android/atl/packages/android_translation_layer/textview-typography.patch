+static gboolean remove_line_height_attribute(PangoAttribute *attribute, gpointer unused)
+{
+    return attribute->klass->type == PANGO_ATTR_LINE_HEIGHT || attribute->klass->type == PANGO_ATTR_ABSOLUTE_LINE_HEIGHT;
+}
+
+JNIEXPORT void JNICALL Java_android_widget_TextView_native_1applyTypography(JNIEnv *env, jobject this,
+        jstring features, jstring variations, jfloat spacing, jfloat extra, jfloat multiplier)
+{
+    GtkWidget *widget = _PTR(_GET_LONG_FIELD(this, "widget"));
+    GtkLabel *label = GTK_IS_TEXT(widget) ? NULL : text_limits_find_label(widget);
+    if (!label && !GTK_IS_TEXT(widget)) return;
+    PangoAttrList *current = label ? gtk_label_get_attributes(label) : gtk_text_get_attributes(GTK_TEXT(widget));
+    PangoAttrList *attributes = current ? pango_attr_list_copy(current) : pango_attr_list_new();
+    const char *feature_string = features ? (*env)->GetStringUTFChars(env, features, NULL) : NULL;
+    const char *variation_string = variations ? (*env)->GetStringUTFChars(env, variations, NULL) : NULL;
+    pango_attr_list_change(attributes, pango_attr_font_features_new(feature_string ? feature_string : ""));
+    PangoFontDescription *font = pango_font_description_new();
+    pango_font_description_set_variations(font, variation_string && *variation_string ? variation_string : NULL);
+    pango_attr_list_change(attributes, pango_attr_font_desc_new(font));
+    pango_font_description_free(font);
+    pango_attr_list_change(attributes, pango_attr_letter_spacing_new((int)CLAMP((double)spacing * PANGO_SCALE, G_MININT, G_MAXINT)));
+    PangoAttrList *removed = pango_attr_list_filter(attributes, remove_line_height_attribute, NULL);
+    if (removed) pango_attr_list_unref(removed);
+    if (extra != 0 || multiplier != 1) {
+        PangoContext *context = gtk_widget_get_pango_context(label ? GTK_WIDGET(label) : widget);
+        PangoFontMetrics *metrics = pango_context_get_metrics(context, pango_context_get_font_description(context), pango_context_get_language(context));
+        double height = (pango_font_metrics_get_ascent(metrics) + pango_font_metrics_get_descent(metrics)) * multiplier + extra * PANGO_SCALE;
+        pango_attr_list_insert(attributes, pango_attr_line_height_new_absolute((int)CLAMP(height, 1, G_MAXINT)));
+        pango_font_metrics_unref(metrics);
+    }
+    if (label) gtk_label_set_attributes(label, attributes);
+    else gtk_text_set_attributes(GTK_TEXT(widget), attributes);
+    pango_attr_list_unref(attributes);
+    if (feature_string) (*env)->ReleaseStringUTFChars(env, features, feature_string);
+    if (variation_string) (*env)->ReleaseStringUTFChars(env, variations, variation_string);
+}
+
+JNIEXPORT void JNICALL Java_android_widget_TextView_native_1setSelectable(JNIEnv *env, jobject this, jboolean selectable)
+{
+    GtkWidget *widget = _PTR(_GET_LONG_FIELD(this, "widget"));
+    if (GTK_IS_TEXT(widget)) return;
+    GtkLabel *label = text_limits_find_label(widget);
+    if (label) gtk_label_set_selectable(label, selectable);
+}
