 #include "../generated_headers/android_media_AudioRecord.h"
 
+/* Capture has different channel masks from AudioTrack. Keep playback setup unchanged. */
+static int configure_capture(snd_pcm_t *pcm, snd_pcm_hw_params_t *params,
+                             unsigned int rate, int config, unsigned int *channels)
+{
+	if (rate == 0) return -EINVAL;
+	switch (config) {
+	case 1: case 2: case 16: *channels = 1; break;
+	case 3: case 12: *channels = 2; break;
+	default: return -EINVAL;
+	}
+	int result = snd_pcm_hw_params_set_access(pcm, params, SND_PCM_ACCESS_RW_INTERLEAVED);
+	if (result < 0) return result;
+	result = snd_pcm_hw_params_set_format(pcm, params, SND_PCM_FORMAT_S16_LE);
+	if (result < 0) return result;
+	result = snd_pcm_hw_params_set_channels(pcm, params, *channels);
+	if (result < 0) return result;
+	unsigned int actual_rate = rate;
+	result = snd_pcm_hw_params_set_rate_near(pcm, params, &actual_rate, NULL);
+	if (result < 0) return result;
+	return actual_rate == rate ? 0 : -EINVAL;
+}
+
+static const char *capture_device(void)
+{
+	const char *configured = getenv("ATL_ALSA_CAPTURE_DEVICE");
+	return configured && *configured ? configured : PCM_DEVICE;
+}
