 	public GskCanvas(long snapshot) {
 		this.snapshot = snapshot;
 		state_stack.push(new Matrix());
+	}
+
+	/** Start an isolated Android drawing frame inside the GTK snapshot. */
+	public void beginFrame(long snapshot) {
+		this.snapshot = snapshot;
+		state_stack.clear();
+		state_stack.push(new Matrix());
+		push_history = null;
+		native_save(snapshot);
+	}
+
+	/** Restore saves and root-level clips before returning to GTK. */
+	public void endFrame() {
+		restoreToCount(1);
+		if (push_history != null && push_history.length > 1 && push_history[1] > 0)
+			native_pop(snapshot, push_history[1]);
+		native_restore(snapshot);
+		push_history = null;
+		state_stack.peek().reset();
+		this.snapshot = 0;
 	}
 
